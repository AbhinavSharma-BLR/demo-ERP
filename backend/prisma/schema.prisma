// ──────────────────────────────────────────────────────────────────────────────
// Manufacturing Management App — Prisma Schema
// Database: PostgreSQL
// ──────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ══════════════════════════════════════════════════════════════════════════════
// ENUMS
// ══════════════════════════════════════════════════════════════════════════════

enum UserRole {
  ADMIN
  PRODUCTION_MANAGER
  OPERATOR
}

enum MoState {
  DRAFT
  CONFIRMED
  IN_PROGRESS
  DONE
  CANCELLED
}

enum WoStatus {
  PENDING
  IN_PROGRESS
  DONE
  BLOCKED
}

enum StockLedgerType {
  IN
  OUT
  ADJUSTMENT
}

// ══════════════════════════════════════════════════════════════════════════════
// USERS & AUTH
// ══════════════════════════════════════════════════════════════════════════════

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  role         UserRole @default(OPERATOR)
  passwordHash String   @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  otpTokens          OtpToken[]
  assignedWorkOrders WorkOrder[] @relation("WoAssignee")
  woTimeLogs         WoTimeLog[]
  woComments         WoComment[]

  @@map("users")
}

model OtpToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  token     String
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("otp_tokens")
}

// ══════════════════════════════════════════════════════════════════════════════
// PRODUCTS
// ══════════════════════════════════════════════════════════════════════════════

model Product {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  unit        String // e.g. "kg", "pcs", "L"
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  bomsAsFinishedGood  Bom[]                @relation("BomFinishedGood")
  bomComponentsUsedIn BomComponent[]       @relation("ComponentProduct")
  manufacturingOrders ManufacturingOrder[]
  stockLedger         StockLedger[]

  @@map("products")
}

// ══════════════════════════════════════════════════════════════════════════════
// WORK CENTERS
// ══════════════════════════════════════════════════════════════════════════════

model WorkCenter {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  capacity    Float    @default(1.0) // hours per day
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  downtimes     WorkCenterDowntime[]
  bomOperations BomOperation[]
  workOrders    WorkOrder[]

  @@map("work_centers")
}

model WorkCenterDowntime {
  id           String    @id @default(uuid())
  workCenterId String    @map("work_center_id")
  reason       String
  startAt      DateTime  @map("start_at")
  endAt        DateTime? @map("end_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  // Relations
  workCenter WorkCenter @relation(fields: [workCenterId], references: [id], onDelete: Cascade)

  @@map("work_center_downtimes")
}

// ══════════════════════════════════════════════════════════════════════════════
// BILLS OF MATERIALS (BOM)
// ══════════════════════════════════════════════════════════════════════════════

model Bom {
  id             String   @id @default(uuid())
  finishedGoodId String   @map("finished_good_id")
  version        Int      @default(1)
  quantity       Float // quantity of finished good produced by this BOM
  isActive       Boolean  @default(true) @map("is_active")
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  finishedGood        Product              @relation("BomFinishedGood", fields: [finishedGoodId], references: [id])
  components          BomComponent[]
  operations          BomOperation[]
  manufacturingOrders ManufacturingOrder[]

  @@unique([finishedGoodId, version])
  @@map("boms")
}

model BomComponent {
  id        String   @id @default(uuid())
  bomId     String   @map("bom_id")
  productId String   @map("product_id")
  quantity  Float
  unit      String
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  bom     Bom     @relation(fields: [bomId], references: [id], onDelete: Cascade)
  product Product @relation("ComponentProduct", fields: [productId], references: [id])

  @@map("bom_components")
}

model BomOperation {
  id              String   @id @default(uuid())
  bomId           String   @map("bom_id")
  workCenterId    String   @map("work_center_id")
  sequence        Int // order of operations (1, 2, 3 …)
  name            String
  durationMinutes Float    @map("duration_minutes")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  bom        Bom        @relation(fields: [bomId], references: [id], onDelete: Cascade)
  workCenter WorkCenter @relation(fields: [workCenterId], references: [id])

  @@map("bom_operations")
}

// ══════════════════════════════════════════════════════════════════════════════
// MANUFACTURING ORDERS (MO)
// ══════════════════════════════════════════════════════════════════════════════

model ManufacturingOrder {
  id        String    @id @default(uuid())
  reference String    @unique // e.g. MO-2026-0001
  productId String    @map("product_id")
  bomId     String    @map("bom_id")
  quantity  Float
  state     MoState   @default(DRAFT)
  deadline  DateTime?
  notes     String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  // Relations
  product    Product       @relation(fields: [productId], references: [id])
  bom        Bom           @relation(fields: [bomId], references: [id])
  components MoComponent[]
  workOrders WorkOrder[]

  @@index([state, deadline])
  @@map("manufacturing_orders")
}

model MoComponent {
  id                   String   @id @default(uuid())
  manufacturingOrderId String   @map("manufacturing_order_id")
  productId            String   @map("product_id")
  requiredQty          Float    @map("required_qty")
  consumedQty          Float    @default(0) @map("consumed_qty")
  unit                 String
  createdAt            DateTime @default(now()) @map("created_at")

  // Relations
  manufacturingOrder ManufacturingOrder @relation(fields: [manufacturingOrderId], references: [id], onDelete: Cascade)

  @@map("mo_components")
}

// ══════════════════════════════════════════════════════════════════════════════
// WORK ORDERS (WO)
// ══════════════════════════════════════════════════════════════════════════════

model WorkOrder {
  id                   String    @id @default(uuid())
  manufacturingOrderId String    @map("manufacturing_order_id")
  workCenterId         String    @map("work_center_id")
  assignedTo           String?   @map("assigned_to") // User.id
  sequence             Int
  name                 String
  status               WoStatus  @default(PENDING)
  plannedDuration      Float     @map("planned_duration") // minutes
  actualDuration       Float?    @map("actual_duration") // minutes, filled when done
  scheduledAt          DateTime? @map("scheduled_at")
  startedAt            DateTime? @map("started_at")
  completedAt          DateTime? @map("completed_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  // Relations
  manufacturingOrder ManufacturingOrder @relation(fields: [manufacturingOrderId], references: [id], onDelete: Cascade)
  workCenter         WorkCenter         @relation(fields: [workCenterId], references: [id])
  assignee           User?              @relation("WoAssignee", fields: [assignedTo], references: [id])
  timeLogs           WoTimeLog[]
  comments           WoComment[]

  @@index([assignedTo, status])
  @@map("work_orders")
}

model WoTimeLog {
  id          String    @id @default(uuid())
  workOrderId String    @map("work_order_id")
  userId      String    @map("user_id")
  startAt     DateTime  @map("start_at")
  endAt       DateTime? @map("end_at")
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at")

  // Relations
  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])

  @@map("wo_time_logs")
}

model WoComment {
  id          String   @id @default(uuid())
  workOrderId String   @map("work_order_id")
  userId      String   @map("user_id")
  body        String
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])

  @@map("wo_comments")
}

// ══════════════════════════════════════════════════════════════════════════════
// STOCK LEDGER
// ══════════════════════════════════════════════════════════════════════════════

model StockLedger {
  id        String          @id @default(uuid())
  productId String          @map("product_id")
  type      StockLedgerType
  quantity  Float // positive = in, negative = out
  reference String? // e.g. MO-2026-0001, manual adjustment ref
  notes     String?
  createdAt DateTime        @default(now()) @map("created_at")

  // Relations
  product Product @relation(fields: [productId], references: [id])

  @@index([productId, createdAt])
  @@map("stock_ledger")
}
